<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/nameDayTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="seg:"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/openHourTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:text="7h às"
        app:layout_constraintTop_toTopOf="@+id/nameDayTextView"
        app:layout_constraintStart_toEndOf="@+id/nameDayTextView" />

    <TextView
        android:id="@+id/closeHourTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:text="23h"
        app:layout_constraintTop_toTopOf="@+id/openHourTextView"
        app:layout_constraintStart_toEndOf="@+id/openHourTextView" />


</androidx.constraintlayout.widget.ConstraintLayout>