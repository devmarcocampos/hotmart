<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/details"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.details.DetailsFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/containerDetails"
                android:visibility="gone">

            <ImageView
                android:id="@+id/imageLocation"
                android:layout_width="match_parent"
                android:background="@color/black"
                android:layout_height="300dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerInfos"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="#14ADB8"
                app:layout_constraintTop_toBottomOf="@+id/imageLocation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" >

                <TextView
                    android:id="@+id/nameLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:textSize="32sp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="#FFFFFF"
                    android:text="DetailsFragment"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <RatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:rating="3"
                    android:theme="@style/RatingBar"
                    style="?android:attr/ratingBarStyleSmall"
                    app:layout_constraintTop_toBottomOf="@+id/nameLocation"
                    app:layout_constraintStart_toStartOf="@+id/nameLocation" />

                <TextView
                    android:id="@+id/grade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:text="DetailsFragment"
                    android:fontFamily="sans-serif"
                    android:layout_marginStart="10dp"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="@id/ratingBar"
                    app:layout_constraintBottom_toBottomOf="@+id/ratingBar"
                    app:layout_constraintStart_toEndOf="@+id/ratingBar"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:id="@+id/fotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOTOS"
                android:fontFamily="sans-serif"
                android:layout_marginTop="32dp"
                android:layout_marginStart="28dp"
                android:textSize="16sp"
                android:textColor="#14ADB8"
                app:layout_constraintTop_toBottomOf="@+id/containerInfos"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewFotos"
                android:background="#FFFFFF"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="22dp"
                app:layout_constraintTop_toBottomOf="@+id/fotos"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOBRE"
                android:fontFamily="sans-serif"
                android:layout_marginTop="32dp"
                android:layout_marginStart="28dp"
                android:textSize="16sp"
                android:textColor="#14ADB8"
                app:layout_constraintTop_toBottomOf="@+id/recyclerViewFotos"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/aboutDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="26dp"
                app:layout_constraintTop_toBottomOf="@+id/about"
                app:layout_constraintStart_toStartOf="@+id/about"
                app:layout_constraintEnd_toEndOf="parent"/>

            <ImageView
                android:id="@+id/iconTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_time"
                android:layout_marginTop="18dp"
                app:layout_constraintStart_toStartOf="@+id/fotos"
                app:layout_constraintTop_toBottomOf="@+id/aboutDescription" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewSchedule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iconTime"
                app:layout_constraintTop_toTopOf="@+id/iconTime" />

            <ImageView
                android:id="@+id/iconPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_phone"
                android:layout_marginTop="22dp"
                app:layout_constraintTop_toBottomOf="@+id/recyclerViewSchedule"
                app:layout_constraintStart_toStartOf="@+id/about" />

            <TextView
                android:id="@+id/phoneTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                app:layout_constraintStart_toEndOf="@+id/iconPhone"
                app:layout_constraintTop_toTopOf="@+id/iconPhone" />

            <ImageView
                android:id="@+id/iconPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_pin"
                android:layout_marginTop="22dp"
                app:layout_constraintTop_toBottomOf="@+id/iconPhone"
                app:layout_constraintStart_toStartOf="@+id/about" />

            <TextView
                android:id="@+id/addressTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="26dp"
                app:layout_constraintStart_toEndOf="@+id/iconPin"
                app:layout_constraintTop_toTopOf="@+id/iconPin"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/reviews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REVIEWS"
                android:layout_marginTop="32dp"
                android:fontFamily="sans-serif"
                android:textColor="#14ADB8"
                app:layout_constraintTop_toBottomOf="@+id/iconPin"
                app:layout_constraintStart_toStartOf="@+id/about"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewComments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/reviews"
                app:layout_constraintTop_toBottomOf="@+id/reviews" />

            <TextView
                android:id="@+id/reviewsDescription"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="26dp"
                app:layout_constraintTop_toBottomOf="@+id/reviews"
                app:layout_constraintStart_toStartOf="@+id/reviews"
                app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>



